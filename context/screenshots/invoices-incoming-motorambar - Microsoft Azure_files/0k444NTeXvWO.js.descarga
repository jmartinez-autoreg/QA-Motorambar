 Relay"}}},ServiceFabric:{ServiceFabricCluster:{Training:{description1:"Permite crear un plan de protección de cargas de trabajo en la nube mediante Azure Defender.",duration1:"51 min",title1:"Plan de protección de cargas de trabajo en la nube mediante Azure Defender"}}},StreamAnalytics:{StreamAnalyticsCluster:{Training:{description1:"Obtenga información sobre cómo crear trabajos de Azure Stream Analytics para procesar datos de entrada, transformarlos con una consulta y devolver resultados.",description2:"Explore cómo Azure Stream Analytics se integra en sus aplicaciones o dispositivos de Internet de las cosas (IoT) para obtener información con los datos de streaming en tiempo real.",duration1:"49 min",duration2:"25 min",title1:"Transformación de los datos mediante Azure Stream Analytics",title2:"Trabajo con flujos de datos mediante Azure Stream Analytics"}}}},Cognition:{MixedReality:{RemoteRenderingAccount:{Training:{description1:"Permite crear una sesión de Azure Remote Rendering y representar un modelo 3D.",duration1:"48 min",title1:"Representación de un modelo con Azure Remote Rendering"}}}}},MicrosoftAADIAM:{AzureActiveDirectory:{Training:{description1:"Utilice OpenID Connect en su aplicación para permitir que los usuarios inicien sesión de forma segura con identidades de Microsoft Entra.",duration1:"50 min",title1:"Proteja su aplicación mediante OpenID Connect y Microsoft Entra ID"},UsefulLink:{title1:"Información general",title2:"Introducción",title3:"Precios"}},EnterpriseApplications:{Training:{description1:"Analice los datos de streaming con un modelo de Machine Learning y visualice el resultado.",duration1:"1 h 53 min",title1:"Analizar imágenes en tiempo real con Machine Learning, Azure IoT Hub y Azure Stream Analytics"},UsefulLink:{title1:"Información general",title2:"Introducción",title3:"Precios"}},Groups:{UsefulLink:{title1:"Información general",title2:"Introducción",title3:"Precios"}},Users:{Training:{description1:"El primer paso para usar Azure es cr