define("Connectors/ConnectorResources.resjson",{ConfigureStorageAccountIdentityResources:{failureDescription:'No se pudo configurar la identidad en la cuenta de almacenamiento "{name}". Error: {errorMessage}',failureTitle:"No se pudo configurar la identidad de la cuenta de almacenamiento",inProgressDescription:'Configurando la identidad en la cuenta de almacenamiento "{name}".',inProgressTitle:"Configuración de la identidad de la cuenta de almacenamiento",successDescription:'La identidad se configuró correctamente en la cuenta de almacenamiento "{name}".',successTitle:"La identidad de la cuenta de almacenamiento se configuró correctamente"},ConnectorAuthenticationResources:{accessKeyId:"Id. de clave de acceso",apply:"Aplicar",discard:"Descartar cambios",intro:"Realice las modificaciones deseadas en los campos de autenticación y haga clic en Aplicar para guardar los cambios.",requiredFieldError:"El valor no debe estar vacío.",secretAccessKey:"Clave de acceso secreta",secretAccessKeyInfo:"Esta clave no se puede recuperar en Azure",secretAccessKeyPlaceholder:"Escriba la nueva clave para cambiarla",testConnection:"Probar la conexión antes de aplicar los cambios"},ConnectorCreateResources:{authenticationInfo:"Elija la identidad administrada a la que el propietario del recurso compartido de datos ha concedido acceso.",authenticationSection:"Autenticación",authenticationType:"Tipo",authenticationTypeSystem:"Identidad administrada asignada por el sistema",authenticationTypeUser:"Identidad administrada asignada por el usuario",basicsTab:"Datos básicos",cancel:"Cancelar",ces:"¿Le ha resultado fácil o difícil crear el conector de almacenamiento en esta página?",connectorName:"Nombre",containerCreateNewCancel:"Cancelar",containerCreateNewName:"Nombre",containerCreateNewNameFormat:"{0} (nuevo)",containerCreateNewSave:"Guardar",containerCreateNewTitle:"Nuevo contenedor",containerName:"Nombre del contenedor conectado",containerNameExistsError:"El nombre del contenedor ya existe.",