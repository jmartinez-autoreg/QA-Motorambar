ctDetails:"Detalles del proyecto",requiredFieldError:"El valor no debe estar vacío.",title:"Nuevo conector de almacenamiento",userAssignedIdentitySelect:"Seleccionar una identidad"},ConnectorDeactivateResources:{cancel:"Cancelar",line1:"Los recursos o aplicaciones que accedan a los datos a través de este conector perderán el acceso.",line2:"La reactivación de un conector más adelante requiere una nueva aprobación del propietario del recurso habilitado para Private Link, lo que puede provocar retrasos.",submit:"Desactivar conector",title:"¿Desactivar conector de almacenamiento?"},ConnectorDeleteResources:{cancelButton:"Cancelar",deleteButton:"Eliminar",description:"Esta acción eliminará permanentemente el conector de almacenamiento y el acceso del servidor a los datos compartidos.",title:"Confirmación de la eliminación"},ConnectorDescriptionResources:{cancel:"Cancelar",label:"Descripción",placeholderFormat:"{0} caracteres como máximo",save:"Guardar",title:"Editar descripción"},ConnectorErrorResources:{uniqueIdMismatch:"Conector de almacenamiento no encontrado",uniqueIdMismatchMessage:'El conector de almacenamiento "{0}" (identificador único: "{1}") ya no existe. Es posible que se haya eliminado y vuelto a crear con el mismo nombre, pero como un nuevo conector de almacenamiento con un identificador único diferente. Si ve otros conectores de almacenamiento con el mismo nombre, son instancias independientes. La versión actual de "{0}" tiene el identificador único "{2}".'},ConnectorMenuViewResources:{authentication:"Autenticación",overview:"Información general",subtitle:"Conector de almacenamiento"},ConnectorOverviewResources:{connectorStatus:"Estado del conector",containersLearnMore:"Más información",containersLearnMoreAria:"Más información sobre los contenedores conectados",containersSubtitle:"Para administrar contenedores o directorios, vaya a la experiencia de contenedores.",containersTitle:"Acceda a los datos compartidos a través de contenedores o directorios conectados.",containersView:"Ver contenedores",dataShareUri:"URI del recurso compartido de datos",description:"Descripción",descriptionEdit:"Editar descripción",descriptionSeeMore:"Ver más",statusBarInactiveMessage:"Este conector de almacenamiento está inactivo; haga clic en Activar para empezar a acceder a los datos.",statusBarTestConnectionErrorPrefix:"Error en la última conexión. ",statusBarTestConnectionMessage:"Para comprobar la conectividad actual con el origen de datos, haga clic en {0}.",storageAccount:"Cuenta de almacenamiento",uniqueId:"Id. exclusivo"},ConnectorResources:{columnDescription:"Descripción",columnName:"Nombre",columnStatus:"Estado",commandActivate:"Activar",commandAdd:"Conector de almacenamiento",commandDeactivate:"Desactivar",commandDelete:"Eliminar",commandEditDescription:"Editar descripción",commandRefresh:"Actualizar",commandTestConnection:"Probar conexión",connectionErrorFormat:"{0} Método: {1} Id. de solicitud: {2}",connectorListCes:"¿Le ha resultado fácil o difícil administrar conectores de almacenamiento en esta página?",connectorListCva:"¿Le ha resultado útil esta experiencia para administrar conectores de almacenamiento?",filterAll:"Todo",filterPlaceholder:"Filtrar por cualquier campo...",intro:"Los conectores de almacenamiento le permiten conectarse a un Data Share y acceder a los datos compartidos directamente desde el origen, por lo que puede ver y transmitir datos sin copiarlos ni migrarlos.",learnMore:"Más información",learnMoreConnector:"Más información sobre los conectores de almacenamiento",noConnectorsCreate:"Crear conector de almacenamiento",noConnectorsText:"Cree un conector de almacenamiento para ver y transmitir datos compartidos.",noConnectorsTitle:"No hay conectores de almacenamiento para mostrar",statusActive:"Activo",statusInactive:"Inactivo",title:"Conectores (versión preliminar)"},CreateConnectedContainerResources:{failureDescription:'No se pudo crear el contenedor conectado "{name}". Error: {errorMessage}',failureTitle: