define("MsPortalImpl/Notifications/NotificationsClientStrings",{AssetTypeNames:{Notification:{lowerPlural:"notificaciones",lowerSingular:"notificación",plural:"Notificaciones"}},AssetTypesNotification:{primaryButtonText:"Actualizar",secondaryButtonText:"Más tarde"},BillingInvoicesNotification:{descriptionBillingAccount:'Haga clic en "Descargar" para descargar las facturas asociadas a su cuenta de facturación. Se abrirá una nueva pestaña y se descargará un archivo ZIP que contiene las facturas.',descriptionSubscriptionAccount:'Haga clic en "Descargar" para descargar las facturas asociadas a su suscripción. Se abrirá una nueva pestaña y se descargará un archivo ZIP que contiene las facturas.',downloadButtonLabel:"Descargar factura",titleBillingAccount:"Descargar facturas de la cuenta de facturación",titleSubscriptionAccount:"Descargar facturas de suscripción"},Iris:{Notification:{OptOutButton:{failMessage:"Se ha detectado un problema al procesar la solicitud. Vuelva a intentarlo más tarde. Si el problema persiste, no dude en ponerse en contacto con nuestro equipo de soporte técnico.",label:"No volver a mostrar",successMessage:"Ya no recibirá este mensaje."}}},MfaEnforcement:{btnLabel:"Habilitar la autenticación multifactor",descriptionP1:"En la fase 2, la autenticación multifactor será necesaria para todos los usuarios que aprovechen la CLI de Azure, Azure PowerShell, Azure Mobile App, herramientas laC, SDK de Azure Identity y MSAL. La aplicación de la fase 2 está programada para comenzar después del 1 de octubre de 2025.",descriptionP2:"Consulte aquí la información actualizada sobre la aplicación de la autenticación multifactor de Azure: {0}",linkText:"Más información",title:"Azure MFA obligatorio: fase 2"},NewSubNotification:{description:"Debe actualizar el portal para empezar a usar la suscripción.",secondaryButtonText:"Aceptar",title:"La suscripción se ha creado."},PreviewApiUsage:{description:"Se detectaron {0} API distintas que usan versiones preliminares en esta sesión.",linkLabel:"Ver detalles",title:"Uso de versión preliminar de la API detectado"},PrivateLinkNotification:{description:"Se produjo un problema en la obtención de suscripciones debido a problemas de conectividad del punto de conexión privado. Hasta que se acceda a este recurso a través del punto de conexión privado, es posible que el portal no funcione correctamente.",details:"Detalles: {0}",primaryButtonText:"Descartar",secondaryButtonText:"Actualizar",title:"Conectividad del punto de conexión privado"},ServiceHealthAlertTypeNames:{healthAdvisory:"Aviso de estado",plannedMaintenance:"Mantenimiento planeado",securityAdvisory:"Aviso de seguridad",serviceIssue:"Problema de servicio"},SubNotification:{allFiltered:"El filtro de suscripciones '{0}' ha quitado todas las suscripciones. Le recomendamos que lo haga menos específico.",error:"Encontramos errores al intentar capturar las suscripciones. Considere la posibilidad de comprobar su conexión y la configuración del firewall o intente actualizar el portal...",filtered:"El filtro de suscripciones '{0}' ha filtrado las suscripciones de un total de {1} a {2}.",filteredTitle:"Filtro de suscripciones",notFilterable:"El filtro de suscripciones '{0}' no se ha aplicado porque no se ha encontrado ninguna suscripción.",notFiltered:"El filtro de suscripciones '{0}' no ha quitado ninguna suscripción. Le recomendamos que lo haga más específico.",primaryButtonText:"Actualizar",title:"Suscripciones"},WhatsNewNotification:{defaultTitle:"Le damos la bienvenida a Azure",description:"Están disponibles las siguientes actualizaciones: {0}",oneTitle:"1 actualización nueva",twoOrMoreTitle:"{0} actualizaciones nuevas"},pastDueSubscriptionsPluralNotificationDescription:"{0} suscripciones vencieron y corren el riesgo de deshabilitarse. Si la información de pago no se actualiza, es posible que los recursos se eliminen.",pastDueSubscriptionsPluralNotificationTitle:"Suscripciones vencidas: potencial interrupción del servicio",pastDueSubscriptionsPluralPrimaryButtonText:"Ir a las suscripciones",pastDueSubscriptionsSecondaryButtonText:"Recordármelo más tarde",pastDueSubscriptionsSingularNotificationDescription:"La suscripción {0} ({1}) venció y corre el riesgo de deshabilitarse. Si no se actualiza la información de pago, puede que se eliminen los recursos.",pastDueSubscriptionsSingularNotificationTitle:"Suscripción vencida: potencial interrupción del servicio",pastDueSubscriptionsSingularPrimaryButtonText:"Ir a la suscripción"});