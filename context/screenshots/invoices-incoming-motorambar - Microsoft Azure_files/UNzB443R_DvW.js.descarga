erted:"Con alerta",busy:"Ocupado",created:"Creado",destroyed:"Destruido",initialized:"Inicializado",provisioning:"Aprovisionando",provisioningFailed:"Error de aprovisionamiento",recycle:"Reciclar",started:"Iniciado",starting:"Iniciando",steady:"Estable",stopped:"Detenido",stopping:"Deteniendo",suspended:"Anulado",teardown:"Desmontado",unhealthy:"Incorrecto",unknown:"Desconocido",unresponsive:"Sin respuesta"},SecurityTypeControl:{ConfidentialVm:{displayText:"Confidencial",label:"Máquinas virtuales confidenciales",notSupportedLocation:"La VM confidencial no se admite en la región seleccionada. Seleccione otra región para usar la VM confidencial.",sublabel:"Todas las características de confianza, con una mayor confidencialidad para las máquinas aisladas o los datos cifrados. Disponible para máquinas de Gen 2.",vmDisplayText:"Máquinas virtuales confidenciales"},ConfidentialVmSupported:{displayText:"Compatible con confidenciales",label:"Compatible con confidenciales",sublabel:"Admite la creación de máquinas virtuales confidenciales y de máquinas virtuales Gen2 con seguridad estándar a partir de un disco duro virtual de disco del sistema operativo Gen2 compatible o una imagen administrada de Gen2."},Standard:{displayText:"Estándar",label:"Estándar",notSupportedImage:"Esta imagen requiere un tipo de seguridad de inicio seguro o máquina virtual confidencial.",sublabel:"Nivel básico de seguridad de las máquinas virtuales."},TrustedLaunch:{displayText:"Inicio seguro",label:"Inicio seguro",sublabel:"Protege frente a ataques persistentes y avanzados en máquinas virtuales de Gen 2 con características configurables como arranque seguro y Módulo de plataforma segura virtual (vTPM).",vmDisplayText:"Máquinas virtuales de inicio seguro"},TrustedLaunchAndConfidentialVmSupported:{displayText:"Se admite el inicio seguro y la máquina virtual confidencial",label:"Inicio seguro y soporte confidencial",sublabel:"Admite la creación de máquinas virtuales confidenciales y de inicio seguro con seguridad estándar desde una versión de imagen de VM de galería, imagen administrada o VHD de disco del sistema operativo de segunda generación compatible."},TrustedLaunchSupported:{displayText:"Inicio seguro admitido",label:"Inicio seguro admitido",sublabel:"Admite la creación de máquinas virtuales de inicio seguro con seguridad estándar a partir de un VHD de disco del sistema operativo de segunda generación compatible, una imagen administrada o una versión de imagen de la galería."},infoBox1PGallery:"Se requiere una máquina virtual de inicio seguro al utilizar esta imagen de la Galería de 1P.",infoText:"Elija un tipo de seguridad que se adapte a sus necesidades: \r\nEstándar incluye protecciones básicas sin costo adicional. \r\nLas máquinas virtuales de Inicio seguro proporcionan características de seguridad adicionales en las máquinas virtuales de Gen 2 para proteger frente a ataques persistentes y avanzados.",infoTextConfidential:'El tipo de seguridad hace referencia a las distintas características de seguridad disponibles para una máquina virtual. Las características de seguridad, como el inicio seguro y las máquinas virtuales confidenciales, ayudan a mejorar la seguridad de las máquinas virtuales de generación 2 de Azure. Sin embargo, no todas las configuraciones de máquina virtual se admiten cuando se usan estas características de seguridad adicionales. Obtenga más información sobre la <a href="{0}"> Máquina virtual de inicio seguro </a> y <a href="{1}">Máquina virtual confidencial </a>.',label:"Tipo de seguridad"},ServiceNames:{customService:"Personalizado"},SpecPicker:{standardNC24adsA100v4:"Standard NC24ads_A100_v4",standardNC48adsA100v4:"Standard NC48ads_A100_v4",standardNC96adsA100v4:"Standard NC96ads_A100_v4",standardND96amsrA100v4:"Standard ND96amsr_A100_v4"},StorageAccount:{Type:{defaultInvalidMessage:"Este tipo de cuenta no es compatible."}},StorageBrowser:{Authentication:{AdUser:{errorMessage:"Se produjo un error. Vuelva a intentarlo."},currentlyAccessKeys:"Clave de acceso",currentlyAzureAD:"Cuenta de usuario de Microsoft Entra",errorMessage:"Se produjo un error. Haga clic aquí para volver a intentarlo.",label:"Método de autenticación: ",noAzureAdPermsMessage:"No tiene permisos para enumerar los datos mediante su cuenta de usuario con el identificador de Microsoft Entra. Haga clic para obtener más información sobre la autenticación con Microsoft Entra ID.",noListKeysPermsMessage:"No tiene permisos para usar la clave de acceso para enumerar datos. Haga clic para obtener más información sobre la autenticación con Azure Storage.",switchToAccessKeys:"(Cambiar a la clave de acceso)",switchToAzureAD:"(Cambiar a la cuenta de usuario de Microsoft Entra)"}},SubnetValidator:{Vmss:{applicationGatewaySubnet:"No se pueden agregar instancias de VMSS a la subred de Application Gateway",gatewaySubnet:"No se pueden agregar instancias de VMSS a la subred de Gateway"}},Text:{none:"Ninguno"},TrustedVm:{configureSecurity:"Configurar características de seguridad",configureSecurityVm:"Configurar características de seguridad adicionales para esta máquina virtual",infoIntegrityMonitoring:"Si la máquina virtual no se inició por un error en la atestación con la línea base definida, la supervisión de la integridad habilitará la atestación criptográfica y la comprobación de la integridad de arranque de la máquina virtual junto con las alertas de supervisión.",infoSecureBoot:"El arranque seguro le permite proteger las VM contra bootkits, rootkits y malware de nivel de kernel.",infovTPM:"El Módulo de plataforma segura virtual (vTPM) es compatible con TPM 2.0 y valida la integridad de arranque de la VM, además de almacenar de forma segura claves y secretos.",integrityMonitoring:"Supervisión de integridad",secureBoot:"Inicio seguro",secureBootLabel:"Habilitar arranque seguro",vTPM:"vTPM",vTPMLabel:"Habilitar vTPM"},UpgradeSecurityTypeControl:{DisabledReason:{automanage:"No se puede actualizar el tipo de seguridad para máquinas virtuales con u