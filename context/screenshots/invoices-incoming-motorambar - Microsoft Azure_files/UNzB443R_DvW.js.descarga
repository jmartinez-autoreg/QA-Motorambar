."},VCPU:{title:"Número insuficiente de vCPU"},Zone:{summary:"No se admiten tamaños en la zona {0}. Cambiar la zona de disponibilidad para seleccionar estos tamaños",title:"Zona de disponibilidad no admitida"},ZoneAny:{summary:"No se admite ninguna zona de disponibilidad para estos tamaños",title:"Este tamaño no admite zonas de disponibilidad"}},Groups:{Av2:{summary:"Ideal para cargas de trabajo de nivel inicial (desarrollo o pruebas)",title:"Serie A v2"},B:{summary:"Ideal para cargas de trabajo que no necesitan un rendimiento de CPU completo continuo",title:"Serie B"},Bsv2:{summary:"Ideal para cargas de trabajo que no necesitan un rendimiento de CPU completo continuo",title:"Serie B v2"},DC:{summary:"Diseñado para proteger la confidencialidad y la integridad del código y los datos para cargas de trabajo de uso general",title:"Serie DC"},Dnv7:{summary:"Los tamaños de familia DN de última generación recomendados para sus cargas de trabajo intensivas en red",title:"Serie Dn v7"},Dsv2:{summary:"Tamaños de la familia D de 2.ª generación para sus necesidades de uso general.",title:"Serie D v2"},Dsv3:{summary:"Tamaños de la familia D de 3.ª generación para sus necesidades de uso general.",title:"Serie D v3"},Dsv4:{summary:"Tamaños de la familia D de 4.ª generación para sus necesidades de uso general.",title:"Serie D v4"},Dsv5:{summary:"Tamaños de la familia D de 5.ª generación recomendados para sus necesidades de uso general",title:"Serie D v5"},Dsv6:{summary:"Tamaños de familia D de 6.ª generación recomendados para sus necesidades de uso general",title:"D-Series v6"},Dsv7:{summary:"Tamaños de la familia D de última generación recomendados para sus necesidades de uso general.",title:"D-Series v7"},EC:{summary:"Diseñado para proteger la confidencialidad y la integridad del código y los datos para cargas de trabajo que consumen mucha memoria",title:"Serie EC"},Ebv6:{summary:"Tamaños de la familia Eb de 6.ª generación para sus necesidades intensivas de almacenamiento remoto 