define("StorageResources.resjson",{AccessControl:{authorizationFailureDescription:'Error de autorización. Puede que los cambios recientes en la configuración "{0}" aún no estén en vigor. Si la configuración se ha cambiado recientemente, espere un minuto y vuelva a visitar esta experiencia.',description:"Todas las redes, incluso Internet, pueden acceder a esta cuenta de almacenamiento.",exceptions:"Excepciones",ipAddress:"Dirección IP (IPv4)",learnMore:"Más información.",learnMoreGrantAccessTextAria:"Obtenga más información sobre cómo conceder acceso desde un intervalo de direcciones IP de Internet.",learnMoreTextAria:"Obtenga más información sobre cómo configurar las redes virtuales y los firewall de almacenamiento de Azure.",privateEndpointConnections:"Conexiones de punto de conexión privado",publicIpRuleValidation:"Las reglas de IP solo admiten direcciones IP públicas.",title:"Firewalls y redes virtuales",unauthorized:'La configuración "{0}" de esta cuenta de almacenamiento puede estar bloqueando el acceso a los servicios de almacenamiento. Pruebe a agregar la dirección IP del cliente a las excepciones del firewall, o a permitir el acceso de "todas las redes" en lugar de las "redes seleccionadas".',unauthorizedWithIp:'La configuración "{0}" de esta cuenta de almacenamiento puede estar bloqueando el acceso a los servicios de almacenamiento. Pruebe a agregar la dirección IP del cliente ("{1}") a las excepciones del firewall o a permitir el acceso de "todas las redes" en lugar de las "redes seleccionadas".'},AccessControl_ClientIpExceptions:{invalidCidr:"Especifique una dirección IP o CIDR.",invalidIp4Address:"Dirección IP no válida."},AccessControl_Exceptions:{title:"Excepciones"},AccessControl_Firewall:{accessibleInfoAllowing:"que permite",accessibleInfoBase:"La configuración de Firewall {0} el acceso a los servicios de almacenamiento permanecerá en vigor hasta un minuto después de guardar la configuración actualizada {1} el acceso.",accessibleInfoRestricting:"que restringe",description:"Agrega intervalos IP para permitir el acceso desde Internet o las redes locales.",title:"Firewall"},AccessControl_Firewall_ClientIp:{help:"Puede que no quiera agregar la dirección IP del cliente si la red desde la que usa Azure Portal es inusual (doméstica frente a entorno de trabajo, por ejemplo).",label:'Agregar la dirección IP del cliente ("{0}")'},AccessControl_Keywords:{acl:"acl",azureServices:"servicios de Azure",network:"Red",security:"seguridad"},AccessControl_Nfs:{learnMore:"Más información acerca de NFS v3"},AccessControl_Nfs_AllNetworks:{warning:'NFS v3 está habilitado para esta cuenta de almacenamiento. Si se establece el acceso de red en "todas las redes", no se podrá acceder a la red con este protocolo.'},AccessControl_Nfs_SubnetRemoved:{warning:"NFS v3 está habilitado para esta cuenta. Al quitar una red virtual, se impedirá que se comparta el acceso."},AccessControl_PublicNetworkAccess:{help:"Permita el acceso a la cuenta de almacenamiento desde su punto de conexión público. Cuando el acceso a la red pública está deshabilitado, el punto de conexión público de esta cuenta de almacenamiento no será accesible y solo se pueden usar conexiones de punto de conexión privado para el acceso."},AccessControl_PublicNetworkAccess_InfoBox:{text:"Se ha deshabilitado el acceso a la red pública a esta cuenta de almacenamiento. Cree una conexión de punto de conexión privado para conceder acceso."},AccessControl_ResourceInstances:{description:"Especifique las instancias de recursos que tendrán acceso a su cuenta de almacenamiento en función de la identidad administrada asignada por el sistema.",searchPlaceholder:"Buscar...",title:"Instancias de recursos"},AccessControl_ResourceInstances_InstanceName:{allInResourceGroup:"Todo lo incluido en el grupo de recursos actual",allInSubscription:"Todo lo incluido en la suscripción actual",allInTenant:"Todo lo incluido en el inquilino actual",label:"Nombre de la instancia",placeholder:"Seleccione una o varias instancias.",placeholderAria:"Seleccione instancias de recursos para excepciones de firewall basadas en instancias",selectedCount:"{0} seleccionado(s)"},AccessControl_ResourceInstances_ResourceTypes:{label:"Tipo de recurso",placeholder:"Seleccione un tipo de recurso",placeholderAria:"Seleccione un tipo de recurso para una excepción de firewall basada en instancias"},AccessControl_Routing:{preference:"Preferencia de enrutamiento",publish:"Publicar los puntos de conexión específicos de la ruta",publishHelp:"Determine los puntos de conexión públicos específicos de la ruta que se van a publicar. Puede encontrar los puntos de conexión publicados en Propiedades.",routingDescription:"Determine cómo quiere redirigir el tráfico desde el origen a un punto de conexión de Azure. El enrutamiento de Microsoft es recomendable para la mayoría de clientes.",routingHelp:"El enrutamiento de red de Microsoft dirigirá el tráfico para que acceda a la nube de Microsoft más cercana al cliente solicitante. En cambio, el enrutamiento de Internet dirigirá el tráfico para que acceda a la nube de Microsoft más cercana al punto de conexión de Azure Storage.",skus:"La combinación actual de tipo de cuenta de almacenamiento, rendimiento, replicación y ubicación no admite el enrutamiento de red.",title:"Enrutamiento de red"},AccessControl_SelectStorage:{filterText:"Seleccionar una o más cuentas de almacenamiento",help:'Seleccione una o más cuentas de almacenamiento con permiso de acceso para el tráfico con la subred "{0}" de la red virtual "{1}". Solo se mostrarán las cuentas de almacenamiento que están en la misma ubicación que la subred.',notSupported:"tipo de cuenta no admitida",provisioningState:'{0} (estado de aprovisionamiento "{1}")',select:"Seleccionar",storageAccounts:"Cuentas de almacenamiento",title:"Seleccionar cuentas de almacenamiento"},AccessControl_StorageDataAccess:{loggingLabel:"Permitir acceso de lectura al registro de almacenamiento desde cualquier red",metricsLabel:"Permitir el acceso de lectura a las métricas de almacenamiento desde cualquier red",title:"Acceso a datos de Storage"},AccessControl_TrustedService:{help:"Solo hay un subconjunto de servicios de Azure en la lista de servicios de confianza.",helpAria:"Obtenga más información sobre los servicios de Microsoft de confianza.",label:"Permita que los servicios de Azure de la lista de servicios de confianza accedan a esta cuenta de almacenamiento.",title:"Servicios Microsoft de confianza"},AccessControl_VirtualNetworks:{addExisting:"Agregar red virtual existente",addressRange:"Intervalo de direcciones",allNetworks:"Todas las redes",allowAccess:"Permitir acceso desde",allowAccessHelp:"Configure la seguridad de red para las cuentas de almacenamiento.",allowedExternalDuplicates:"Se han especificado dos intervalos de direcciones idénticos. Los intervalos de direcciones deben ser únicos.",allowedExternalPlaceholder:"Dirección IP o CIDR",createNew:"Agregar nueva red virtual",deleted:"No encontrado",description:"Proteja su cuenta de almacenamiento con las redes virtuales.",disableNetworks:"Deshabilitado",disabled:"Deshabilitado",enableAllNetworks:"Habilitado desde todas las redes",enableSelectedNetworks:"Habilitado desde redes virtuales y direcciones IP seleccionadas",enabled:"Habilitado",endpointStatus:"Estado del punto de conexión",failed:"Erróneo",noNetworks:"No se ha seleccionado ninguna red.",permissions:"Permisos insuficientes",publicNetworkAccess:"Acceso a la red pública",publicNetworkAccessScope:"Ámbito de acceso a la red pública",securedByPerimeter:"Protegido por perímetro",selectedNetworks:"Redes seleccionadas",subnet:"Subred",title:"Redes virtuales",unknown:"Desconocido",updating:"Actualización",virtualNetwork:"Virtual Network"},AccessControl_VirtualNetworks_EnablePublicNetworkAccess:{title:"Habilitar el acceso a la red pública"},AccessControl_VirtualNetworks_UnableToRetrieve:{deleted:'El estado "No encontrado" indica que puede que una subred se haya movido o eliminado.',info:"No se puede recuperar el estado del punto de conexión para una o varias subredes. {0}",permissions:'El estado "Permisos insuficientes" indica la falta de permisos de lectura de la subred ("{0}").',unknown:'El estado "Desconocido" indica un error inesperado. Haga clic aquí para abrir una incidencia de soporte técnico.'},Accessibility_GridAriaLabels:{blob:"Lista de blobs en el contenedor.",blobInFolder:"Lista de blobs en la carpeta.",container:"Lista de contenedores en la cuenta de almacenamiento.",corsblade:"Lista de reglas de CORS para el servicio {0}.",files:"Lista de archivos en el recurso compartido de archivos.",filesInFolder:"Lista de archivos en la carpeta.",fileshare:"Lista de recursos compartidos de archivos en la cuenta de almacenamiento.",lifecycleRules:"Lista de reglas de administración del ciclo de vida",message:"Lista de mensajes en la cola.",queue:"Lista de colas en la cuenta de almacenamiento.",table:"Lista de tablas en la cuenta de almacenamiento."},AccountFailover:{infoMessage1a:"Si inicia la conmutación por error, puede perder todos los datos o metadatos transcurrido este tiempo.",infoMessage1b:"Esta conmutación por error solo se completará después de sincronizar todos los datos con la región de destino.",infoMessage2a:"Después de finalizar la conmutación por error, la replicación de la cuenta de almacenamiento se convertirá en una cuenta de almacenamiento con redundancia local (LRS).",infoMessage2b:"Puede convertir su cuenta para usar el almacenamiento con redundancia geográfica (GRS) o el almacenamiento con redundancia geográfica con acceso de lectura (RA-GRS).",infoMessage3:"Después de volver a habilitar la replicación {0} o {1} en su cuenta de almacenamiento, Microsoft replicará los datos en la nueva región secundaria. El tiempo de replicación depende de muchos factores y hay cargos de ancho de banda por esta transferencia de datos.",lastSyncTimeLabel:"La hora de la última sincronización es",lrsWarning:"Durante la experiencia (versión preliminar), no puede volver a convertir la cuenta a almacenamiento con redundancia de zona geográfica (GZRS) o a almacenamiento con redundancia de zona geográfica con acceso de lectura (RA-GZRS)",message:"El punto de conexión secundario de la cuenta de almacenamiento se convertirá en el principal una vez finalizada la conmutación por error. Debe estar al tanto del siguiente efecto en su cuenta de almacenamiento antes de iniciar la conmutación por error:",selectionTitle:"Elegir tipo de conmutación por error",v2infoMessage2a:"Su cuenta de almacenamiento se moverá a {0} y será {1}.",v2infoMessage2b:"Su cuenta de almacenamiento será {0} con {1} como ubicación principal y {2} como ubicación secundaria.",v2infoMessage3:"Puede actualizar la configuración de redundancia de su cuenta una vez completada la conmutación por error. El tiempo de replicación depende de muchos factores y hay cargos de ancho de banda por esta transferencia de datos.",yes:"sí"},AccountFailover_Confirm_Failover:{label:"Confirmar conmutación por error",placeholder:'Escriba "sí" para confirmar'},AccountFailover_Error:{message:"Error en la operación de conmutación por error."},AccountFailover_Error_CanFailover:{message:"No se admite la conmutación por error para las regiones primaria y secundaria o bien se ha habilitado una funcionalidad que no es compatible con la conmutación por error. Para obtener más información, haga clic aquí."},AccountFailover_Error_HnsEnabled:{message:"Actualmente, no se admite la conmutación por error de cuentas de almacenamiento con un espacio de nombres jerárquico habilitado (cuentas de almacenamiento de Azure Data Lake Storage Gen2)."},AccountFailover_Error_InProgress:{message:"Ya hay una operación de conmutación por error en curso."},AccountFailover_Error_NfsV3:{message:"En este momento no se admite la conmutación por error para las cuentas de almacenamiento con NFS V3."},AccountFailover_Error_Unavailable:{message:"La conmutación por error no se puede iniciar aún porque la sincronización de datos inicial de la región principal a la secundaria está en curso. La conmutación por error estará disponible cuando se complete la sincronización. Haga clic aquí para obtener más información."},AccountFailover_InProgress:{message:"La operación de la conmutación por error está en curso."},AccountFailover_Info_FailoverWithHns_PrivatePreview:{message:"La compatibilidad con la conmutación por error para las cuentas de almacenamiento con el espacio de nombres jerárquico habilitado (cuentas de almacenamiento de Azure Data Lake Storage Gen2) está en versión preliminar privada. Para inscribirse a la versión preliminar, deberá enviar una solicitud para registrar esta característica en su suscripción."},AccountFailover_LRS:{infoMessage:"Después de la conmutación por error de una cuenta GRS o RA-GRS, la replicación de la cuenta de almacenamiento se convertirá en una cuenta de almacenamiento con redundancia local (LRS). Puede convertir su cuenta para usar GRS o RA-GRS."},AccountFailover_Selection1:{description:"Si una interrupción provoca que el punto de conexión principal no esté disponible, puede iniciar una conmutación por error en el punto de conexión secundario para restaurar rápidamente el acceso de escritura a sus datos.",text:"Conmutación por error no planeada"},AccountFailover_Selection2:{description:"Si necesita cambiar los puntos de conexión principal y secundario, puede iniciar una conmutación por error planeada sin perder la redundancia geográfica.",text:"Conmutación por error planeada (versión preliminar)"},AccountFailover_Triggered:{message:"Se desencadenó la operación de conmutación por error. Esperando a que se acepte la operación."},AccountFailover_ZRS:{infoMessage:"Después de la conmutación por error de una cuenta GZRS, la replicación de la cuenta de almacenamiento se convertirá en una cuenta de almacenamiento con redundancia de zona (ZRS). Puede convertir su cuenta a GZRS o RA-GZRS mediante PowerShell o CLI."},ActionBar_Create:{text:"Crear"},ActiveDirectoryBlade:{title:"{0} | Acceso basado en identidades"},ActiveDirectoryBlade_AADDSContextPane:{subtitle:"Microsoft Entra Domain Services"},ActiveDirectoryBlade_AADDSContextPane_InfoSection_Header:{text:"Documentación"},ActiveDirectoryBlade_AADDSContextPane_InfoSection_Link1:{text:"Habilitar la autenticación de Microsoft Entra Domain Services"},ActiveDirectoryBlade_AADDSContextPane_InfoSection_Link2Description:{text:"¿No está seguro de si esta es la opción adecuada para usted?"},ActiveDirectoryBlade_AADDSContextPane_InfoSection_OverviewLink:{text:"Introducción a las opciones de autenticación basada en identidades de Azure Files"},ActiveDirectoryBlade_ADContextPane:{subtitle:"Active Directory (AD)"},ActiveDirectoryBlade_ADContextPane_Description:{text:"Para habilitar la autenticación basada en Active Directory para recursos compartidos de archivos de Azure, es necesario realizar los pasos fuera de Azure Portal."},ActiveDirectoryBlade_ADContextPane_DocumentationSection_Header:{text:"Documentación"},ActiveDirectoryBlade_ADContextPane_DocumentationSection_Link:{text:"Guía paso a paso para habilitar la autenticación basada en AD"},ActiveDirectoryBlade_ADContextPane_VideoSection_Accordion_Header:{text:"Documentación a la que se hace referencia"},ActiveDirectoryBlade_ADContextPane_VideoSection_Accordion_Link1:{text:"Introducción a Identity"},ActiveDirectoryBlade_ADContextPane_VideoSection_Accordion_Link2:{text:"Cómo unir a un dominio una cuenta de almacenamiento"},ActiveDirectoryBlade_ADContextPane_VideoSection_Accordion_Link3:{text:"Introducción a redes para recursos compartidos de archivos de Azure"},ActiveDirectoryBlade_ADContextPane_VideoSection_Accordion_Link4:{text:"Cómo configurar puntos de conexión públicos y privados"},ActiveDirectoryBlade_ADContextPane_VideoSection_Accordion_Link5:{text:"Cómo configurar una VPN S2S"},ActiveDirectoryBlade_ADContextPane_VideoSection_Accordion_Link6:{text:"Cómo configurar una VPN P2S de Windows"},ActiveDirectoryBlade_ADContextPane_VideoSection_Accordion_Link7:{text:"Cómo configurar una VPN P2S de Linux"},ActiveDirectoryBlade_ADContextPane_VideoSection_Accordion_Link8:{text:"Cómo configurar el reenvío de DNS"},ActiveDirectoryBlade_ADContextPane_VideoSection_Accordion_Link9:{text:"Configurar DFS-N"},ActiveDirectoryBlade_ADContextPane_VideoSection_Accordion_MinuteDetails:{text:"Minuto {0} -"},ActiveDirectoryBlade_ADContextPane_VideoSection_Description:{text:"Cómo habilitar el acceso basado en identidades para cuentas de Active Directory desde el entorno local:"},ActiveDirectoryBlade_ADContextPane_VideoSection_Header:{text:"Vídeo"},ActiveDirectoryBlade_AdditionalInfoSection1_Description1:{text:"En este primer paso, elija el origen de identidad que contiene las cuentas de usuario que tendrán acceso a un recurso compartido de esta cuenta de almacenamiento."},ActiveDirectoryBlade_AdditionalInfoSection1_Description2_Info1:{text:'Active Directory Domain Services (AD DS) que hospeda en Windows Server (denominado generalmente "AD local", aunque puede hospedar estos servidores en Azure)'},ActiveDirectoryBlade_AdditionalInfoSection1_Description2_Info2:{text:"Microsoft Entra Domain Services, una plataforma como servicio, un servicio de directorio hospedado y un controlador de dominio en Azure"},ActiveDirectoryBlade_AdditionalInfoSection1_Description2_Label:{text:"Puede configurar el control de acceso basado en identidades para las cuentas de usuario que se encuentran en estos controladores de dominio:"},ActiveDirectoryBlade_AdditionalInfoSection1_Header:{text:"Habilitación de un origen de identidad"},ActiveDirectoryBlade_AdditionalInfoSection1_InfoBox:{text:"Microsoft Entra ID no es un controlador de dominio, solo un servicio de directorio. Actualmente, no se admiten las cuentas de usuario basadas únicamente en Microsoft Entra ID."},ActiveDirectoryBlade_AdditionalInfoSection2_Description1:{text:"Al habilitar el acceso basado en identidades, puede establecer para cada recurso compartido los usuarios y grupos que tendrán acceso a ese recurso compartido en particular."},ActiveDirectoryBlade_AdditionalInfoSection2_Description2:{text:"Una vez que un usuario tiene permiso para un recurso compartido, los permisos de NTFS de los archivos y carpetas individuales se hacen cargo. Esto permite un control detallado de los permisos, similar a un recurso compartido SMB en Windows Server."},ActiveDirectoryBlade_AdditionalInfoSection2_Header:{text:"Establecer permisos de nivel de recurso compartido"},ActiveDirectoryBlade_AnotherAccessMethodConfigured_Description:{text:"Ya hay otro método de acceso configurado"},ActiveDirectoryBlade_Header:{text:"Acceso basado en identidades"},ActiveDirectoryBlade_Header_Description1:{text:"El acceso basado en identidades se puede habilitar en dos pasos para un recurso compartido concreto en esta cuenta de almacenamiento."},ActiveDirectoryBlade_Header_Description2:{text:"Esto permite a los usuarios individuales usar su cuenta de Active Directory o Microsoft Entra para obtener acceso a un recurso compartido de archivos específico."},ActiveDirectoryBlade_ShareLevelPermissionsContextPane:{subtitle:"Permisos de nivel de recurso compartido"},ActiveDirectoryBlade_ShareLevelPermissionsContextPane_OptionalStep_Description:{text:"Una vez que haya configurado los permisos de nivel de recurso compartido en el paso anterior, es probable que quiera realizar alguna de las siguientes acciones:"},ActiveDirectoryBlade_ShareLevelPermissionsContextPane_OptionalStep_Header:{text:"Opcional, pasos siguientes"},ActiveDirectoryBlade_ShareLevelPermissionsContextPane_OptionalStep_HowToMountLink:{text:"Cómo montar un recurso compartido de archivos de Azure desde una máquina unida a un dominio"},ActiveDirectoryBlade_ShareLevelPermissionsContextPane_OptionalStep_LearnLink:{text:"Más información sobre cómo funcionan las ACL del recurso compartido, las ACL de NTFS y los grupos integrados"},ActiveDirectoryBlade_ShareLevelPermissionsContextPane_RequiredStep_Description:{text:"Al igual que un recurso compartido de SMB en Windows Server, es necesario establecer permisos de nivel de recurso compartido en un recurso compartido de archivos de Azure para que los usuarios de AD puedan tener acceso al recurso compartido:"},ActiveDirectoryBlade_ShareLevelPermissionsContextPane_RequiredStep_Header:{text:"Paso necesario"},ActiveDirectoryBlade_ShareLevelPermissionsContextPane_RequiredStep_Link:{text:"Cómo asignar permisos de nivel de recurso compartido a usuarios y grupos"},AddDirectoryBlade_Name:{label:"Nombre"},AdvisorRecommendations:{title:"Recomendaciones de Advisor"},AlertRules:{launcherPartTitle:"Alertas (clásico)"},AllowSharedKey:{disabledWarning:"La autorización con la clave compartida está deshabilitada para esta cuenta. Todas las solicitudes autorizadas con la clave compartida, incluidas las firmas de acceso compartido (SAS), se denegarán.",info:"Cuando la opción Permitir el acceso a la clave de la cuenta de almacenamiento esté deshabilitada, se denegará cualquier solicitud para la cuenta que se haya autorizado con una clave compartida, incluidas las firmas de acceso compartido (SAS).",learnMore:"Más información sobre la opción Permitir el acceso a la clave de la cuenta de almacenamiento.",pickerWarning:"La autorización con clave compartida está deshabilitada en la cuenta de almacenamiento seleccionada. Todas las solicitudes para la cuenta autorizadas con una clave compartida, incluidas las firmas de acceso compartido (SAS), se denegarán.",pickerWarningTitle:"Seleccionar otra cuenta de almacenamiento"},AssetTypeNames_ClassicStorageAccount:{lowerSingular:"cuenta de almacenamiento (clásico)",singular:"Cuenta de almacenamiento (clásica)"},AssetTypeNames_ClassicStorageAccounts:{lowerPlural:"cuentas de almacenamiento (clásico)",plural:"Cuentas de almacenamiento (clásicas)"},AssetTypeNames_ImportExportJob:{lowerPlural:"trabajos de importación o exportación",lowerSingular:"trabajo de importación o exportación",plural:"Trabajos de importación o exportación",singular:"Trabajo de importación o exportación"},AssetTypeNames_StorageAccount:{lowerSingular:"cuenta de almacenamiento",singular:"Cuenta de almacenamiento"},AssetTypeNames_StorageAccounts:{lowerPlural:"cuentas de almacenamiento",plural:"Cuentas de almacenamiento"},AssetTypeNames_StorageExplorer:{lowerSingular:"explorador de storage",singular:"Explorador de Storage"},AzureActiveDirectoryDomainServices:{title:"Microsoft Entra Domain Services"},Blade:{title:"{0} - {1}"},BlobAcl:{accessPermissions:"Permisos de acceso",addMask:"Agregar máscara",addPrincipal:"Agregar entidad de seguridad",configureDefault:"Configurar permisos predeterminados",contextMenuLabel:"Administrar dirección ACL",defaultIntro:"La lista ACL predeterminada determina los permisos para los elementos secundarios nuevos de este directorio. Si cambia la ACL predeterminada, esta no afectará a los elementos secundarios que ya existen.",defaultLearnMore:"Más información acerca de las listas ACL predeterminadas",defaultPermissions:"Permisos predeterminados",executeNotice:"Los permisos de lectura y escritura solo funcionan en una entidad de seguridad si esta también tiene permisos de ejecución en todos los directorios principales, incluido el contenedor (directorio raíz).",group:"Grupo propietario",groupFormat:"Grupo propietario: {0}",learnMore:"Más información sobre las listas de control de acceso (ACL)",mask:"Máscara",maskWarning:"Los siguientes permisos de acceso superan los límites de la máscara: {0}.",other:"Otros",owner:"Propietario",ownerFormat:"Propietario: {0}",pathLabel:"Establecer y administrar permisos para:",resourceMenuLabel:"Administrar dirección ACL",rootDirectory:"directorio raíz",subtitle:"contenedor: {1} (cuenta de almacenamiento: {0})",title:"Administrar dirección ACL"},BlobAcl_Buttons:{discard:"Descartar",save:"Guardar"},BlobAcl_Columns:{action:"Acción",editOwner:"Editar el propietario",editOwningGroup:"Editar el grupo propietario",execute:"Ejecutar",principal:"Entidad de seguridad