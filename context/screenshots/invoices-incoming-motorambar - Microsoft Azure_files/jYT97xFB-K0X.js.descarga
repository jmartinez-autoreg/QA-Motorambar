aure este."},StorageBrowser_UndeleteContainerBlade_ExistingContainer_TextBox:{text:"Nombre"},StorageBrowser_UndeleteContainerBlade_NewContainer_TextBox:{label:"Nombre"},StorageBrowser_UndeleteContainerBlade_RestoreRadioBtn:{infoBalloonText:"Realiza la restauración en un contenedor existente o uno nuevo. Si se realiza la restauración en un contenedor existente, se sobrescribirá el contenido existente en ese contenedor.",label:"Restaurar a"},StorageBrowser_UndeleteContainerBlade_RestoreRadioBtn_Options:{existingContainer:"Contenedor existente",newContainer:"Nuevo contenedor"},StorageBrowser_UploadBlobBlade_RetentionPolicyRadioButtons:{label:"Directiva de retención",mustBeVlwContainer:"Habilite la inmutabilidad de nivel de versión en el contenedor para establecer una directiva de retención.",noRetention:"Sin retención",useAccountRetention:"Usar período de retención de nivel de cuenta: {0} día(s)",useContainerRetention:"Usar período de retención de nivel de contenedor: {0} día(s)",useCustomRetention:"Elegir un período de retención personalizado:",useCustomRetentionNoColon:"Elegir un período de retención personalizado:"},StorageBrowser_UploadFile:{info:"Elija uno o varios archivos para cargarlos. Los archivos se cargarán en segundo plano. Puede seguir usando el portal mientras la transferencia esté en curso.",overwriteCheckRunning:"Comprobando si hay conflictos de nombres... Esto puede tardar un poco cuando se incluyen muchos archivos.",overwriteExisting:"Sobrescribir los archivos si ya existen",title:"Cargar archivos",warning:"Los siguientes archivos ya existen: {0}"},StorageBrowser_UploadFile_ActionBar:{label:"Listo"},StorageBrowser_UploadFile_Fields:{files:"Archivos"},StorageBrowser_UploadFile_Validation:{failedToValidateNames:"No se pudieron validar los nombres de archivo."},StorageBrowser_UploadManager:{currentUploads:"Cargas actuales",dismiss:"Descartar:",filterText:"Buscar para filtrar elementos",noRows:"No hay cargas",resumableUploads:"Cargas reanudables",title:"